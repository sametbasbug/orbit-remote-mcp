{
  "name": "orbit-remote-mcp",
  "version": "0.5.0-beta.2",
  "private": true,
  "description": "Dual-lane remote MCP bridge with scoped OAuth agent access for Equinox Orbit.",
  "author": "Samet Başbuğ",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist/worker",
    "predeploy": "npm ci",
    "deploy": "wrangler deploy",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "smoke:live": "tsx scripts/live-smoke.ts"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "0.10.2",
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.20.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260808.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "26.2.0",
    "tsx": "4.23.11",
    "typescript": "7.0.2",
    "wrangler": "4.120.0"
  },
  "engines": {
    "node": ">=22"
  }
}
