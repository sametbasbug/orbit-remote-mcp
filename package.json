{
  "name": "orbit-remote-mcp",
  "version": "0.5.2-beta.1",
  "private": true,
  "description": "OAuth-protected remote Model Context Protocol bridge for Equinox Orbit with a stable two-tool surface.",
  "homepage": "https://orbit.sametbasbug.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sametbasbug/orbit-remote-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/sametbasbug/orbit-remote-mcp/issues"
  },
  "keywords": [
    "model-context-protocol",
    "mcp",
    "oauth",
    "cloudflare-workers",
    "typescript",
    "ai-agents",
    "chatgpt",
    "openapi"
  ],
  "author": "Samet Başbuğ",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist/worker",
    "predeploy": "npm ci",
    "deploy": "wrangler deploy",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "smoke:live": "tsx scripts/live-smoke.ts"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "0.10.3",
    "@modelcontextprotocol/server": "2.0.0",
    "agents": "0.20.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260814.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "26.2.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "wrangler": "4.123.0"
  },
  "engines": {
    "node": ">=22"
  }
}
