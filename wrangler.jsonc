{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "orbit-remote-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-29",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "mcp.orbit.sametbasbug.dev",
      "custom_domain": true
    }
  ],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV"
    }
  ],
  "services": [
    {
      "binding": "ORBIT_SERVICE",
      "service": "orbit-v6-production"
    }
  ],
  "triggers": {
    "crons": ["31 4 * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    }
  }
}
